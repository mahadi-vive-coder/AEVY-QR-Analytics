# ==============================================================================
# AEVY QR Analytics & Dynamic Tracking - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION QR TRACKING URL (CRITICAL)
# ------------------------------------------------------------------------------
# The permanent public base URL where dynamic QR codes will resolve to.
# Dynamic QR codes generate links as: ${APP_URL}/q/${qrId}
# Example: https://qr.aevyfragrance.com/q/AEVY-QR-000004
#
# IMPORTANT:
# - NEVER hardcode or use ais-dev-*.run.app, localhost, or 127.0.0.1 in production!
# - If APP_URL is missing in production, the server will display a clear configuration error.
# - Can also be configured directly in Admin Settings -> Production QR URL.
APP_URL="https://ais-dev-cqp32o443hn6scwtsr2xs6-363037920697.asia-east1.run.app"

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# 2. PERSISTENT JSON STORAGE FOR GOOGLE CLOUD RUN
# ------------------------------------------------------------------------------
# The application uses pure JSON files for storage (no Supabase, Firebase, or SQL).
# To survive Cloud Run restarts and redeployments, specify one of the following:
#
# Option A: Cloud Run Volume Mount path (Google Cloud Storage FUSE mount)
# Mount your Cloud Storage bucket to /mnt/data and set:
DATA_DIR="/mnt/data"
# (If not specified, defaults to ./data)
#
# Option B: Direct Cloud Storage Synchronizer
# Provide your Google Cloud Storage bucket name to auto-sync JSON database files:
# GCS_BUCKET="aevy-qr-storage-bucket"

# ------------------------------------------------------------------------------
# 3. REGIONAL & BUSINESS LOCALIZATION
# ------------------------------------------------------------------------------
TIMEZONE="Asia/Dhaka"

# ------------------------------------------------------------------------------
# 4. OPTIONAL GEOLOCATION API
# ------------------------------------------------------------------------------
# Optional key for external IP geolocation. An approximate local fallback is used if empty.
GEOLOCATION_API_KEY=""

# ------------------------------------------------------------------------------
# 5. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Session encryption secret for local admin authentication tokens
SESSION_SECRET="aevy_luxury_secure_session_secret_2026"

# Initial admin credentials
ADMIN_EMAIL="aevy.brand@gmail.com"
ADMIN_PASSWORD="aevy_fragrance_admin_2026"
