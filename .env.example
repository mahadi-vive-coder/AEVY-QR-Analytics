# ==============================================================================
# AEVY QR Analytics & Dynamic Tracking - Vercel Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION QR TRACKING URL
# ------------------------------------------------------------------------------
# Leave unset initially.
# Set this to your production domain or Vercel URL once your deployment URL is known:
# APP_URL="https://your-project.vercel.app"
APP_URL=""

# ------------------------------------------------------------------------------
# 2. VERCEL BLOB STORAGE (PRIVATE JSON DATA OBJECTS)
# ------------------------------------------------------------------------------
# In Vercel, Blob credentials can be provided automatically via Vercel OIDC
# or via BLOB_READ_WRITE_TOKEN when linked to a Vercel Blob store.
# No manual token is required if Vercel OIDC is enabled on your project.
BLOB_READ_WRITE_TOKEN=""

# One-time migration trigger: Set to "true" only when ready to migrate local JSON files
# to Vercel Blob storage. Kept "false" by default.
MIGRATION_MODE="false"

# Local Development Fallback Directory (optional, defaults to ./data)
DATA_DIR="./data"

# Local Server Port (only used in local development)
PORT=3000

# ------------------------------------------------------------------------------
# 3. REGIONAL & BUSINESS LOCALIZATION
# ------------------------------------------------------------------------------
TIMEZONE="Asia/Dhaka"

# ------------------------------------------------------------------------------
# 4. OPTIONAL GEOLOCATION API
# ------------------------------------------------------------------------------
# Optional key for external IP geolocation (ipapi.co). Leave empty for default geo lookup.
GEOLOCATION_API_KEY=""

# ------------------------------------------------------------------------------
# 5. REQUIRED SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Required secret environment variable for session signature encryption.
# Provide a strong random secret in your Vercel Project Environment Variables.
SESSION_SECRET=""

# Required admin credentials. Provide your desired admin password as a secret in Vercel.
ADMIN_EMAIL="aevy.brand@gmail.com"
ADMIN_PASSWORD=""
